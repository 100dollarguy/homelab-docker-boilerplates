IMAGE=n8nio/n8n:latest
CONTAINER_NAME=n8n

PORT=5678
TIMEZONE=Asia/Kolkata

# Required for correct webhook URLs when behind a reverse proxy
N8N_PROTOCOL=https
N8N_HOST=n8n.yourdomain.com
WEBHOOK_URL=https://n8n.yourdomain.com/

# Encrypts stored credentials. Generate with: openssl rand -hex 32
# Without this, n8n generates a random key on first boot — lose the volume = lose all credentials
N8N_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

NETWORK=proxy_net
